# Copy this file to .env on the Docker host and replace every change-me value.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8999
DOCKER_NETWORK=phsardigital
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=https://app.example.com

POSTGRES_USER=phsardigital
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://phsardigital-db:5432/phsardigital_db

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PUBLIC_URL=https://auth.example.com
KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/phsardigital
KEYCLOAK_INTERNAL_URL=http://phsardigital-kc:8080
KEYCLOAK_JWK_SET_URI=http://phsardigital-kc:8080/realms/phsardigital/protocol/openid-connect/certs
KEYCLOAK_REALM=phsardigital
KEYCLOAK_CLIENT_ID=phsar_digital_client
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_JAVA_OPTS=-Xms512m -Xmx2048m

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=products
MINIO_INTERNAL_URL=http://phsardigital-minio:9000
MINIO_PUBLIC_URL=https://files.example.com


BAKONG_API_TOKEN=change-in-vps
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_ACCOUNT_ID=ratanak_thai@bkrt
BAKONG_MERCHANT_NAME=Anajak Store
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_MERCHANT_ID=1516169
BAKONG_ACQUIRING_BANK=ACLEDA Bank Plc
BAKONG_STORE_LABEL=Toul Kork

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/urandom
